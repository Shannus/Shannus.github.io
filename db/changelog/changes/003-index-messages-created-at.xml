<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-index-messages-created-at" author="shanz">
        <preConditions onFail="MARK_RAN">
            <not><indexExists indexName="idx_messages_created_at" schemaName="${tenant}"/></not>
        </preConditions>
        <createIndex schemaName="${tenant}" tableName="messages" indexName="idx_messages_created_at">
            <column name="created_at" descending="true"/>
        </createIndex>
        <rollback>
            <dropIndex schemaName="${tenant}" tableName="messages" indexName="idx_messages_created_at"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
