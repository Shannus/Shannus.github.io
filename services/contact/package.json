{
  "name": "@portfolio/contact",
  "version": "1.0.0",
  "private": true,
  "description": "Contact intake service (V1 product line): API Gateway -> Lambda -> Postgres",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node esbuild.mjs",
    "package": "cd dist && zip -qr ../function.zip index.js && echo packaged function.zip",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "3.679.0",
    "@types/aws-lambda": "8.10.145",
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "esbuild": "0.24.0",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  },
  "overrides": {
    "pg-connection-string": "2.7.0"
  }
}
